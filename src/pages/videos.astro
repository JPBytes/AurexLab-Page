---
import Layout from "../layouts/Layout.astro";

const feedVideos = [
  {
    portada:
      "https://images.unsplash.com/photo-1591488320449-011701bb6704?auto=format&fit=crop&q=80&w=800",
    titulo: "Restauración de GPU: Cambio de Pads Térmicos",
    descripcion:
      "Reviviendo una tarjeta gráfica con altas temperaturas. Paso a paso del desarmado y limpieza.",
    plataforma: "YouTube",
    categoria: "Reparación",
  },
  {
    portada:
      "https://images.unsplash.com/flagged/photo-1574506272440-8bebbef1ee26?auto=format&fit=crop&q=80&w=800",
    titulo: "Setup Minimalista 2026: Menos es más",
    descripcion:
      "Cómo organizar tu escritorio para maximizar la productividad y reducir el ruido visual.",
    plataforma: "TikTok",
    categoria: "Consejos",
  },
  {
    portada:
      "https://images.unsplash.com/photo-1550751827-4bd374c3f58b?auto=format&fit=crop&q=80&w=800",
    titulo: "IA en el código: ¿El fin de los programadores?",
    descripcion:
      "Analizamos las nuevas herramientas de autocompletado cuántico y su impacto en el desarrollo web.",
    plataforma: "YouTube",
    categoria: "Tecnología",
  },
  {
    portada:
      "https://images.unsplash.com/photo-1581092160562-40aa08e78837?auto=format&fit=crop&q=80&w=800",
    titulo: "Mantenimiento Preventivo de Servidores",
    descripcion:
      "Evita caídas de sistema con este chequeo semanal de hardware y flujos de aire.",
    plataforma: "TikTok",
    categoria: "Mantenimiento",
  },
  {
    portada:
      "https://images.unsplash.com/photo-1774915294244-02299e8dc09f?q=80&w=2070&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D?auto=format&fit=crop&q=80&w=800",
    titulo: "Nuevos monitores OLED transparentes",
    descripcion:
      "Un primer vistazo a la tecnología de pantallas que veremos en todas las oficinas este año.",
    plataforma: "YouTube",
    categoria: "Novedades",
  },
  {
    portada:
      "https://images.unsplash.com/photo-1542751371-adc38448a05e?auto=format&fit=crop&q=80&w=800",
    titulo: "Arreglando el drift de tus controles",
    descripcion:
      "Un truco rápido de 30 segundos para solucionar problemas de palanca sin abrir el mando.",
    plataforma: "TikTok",
    categoria: "Reparación",
  },
  {
    portada:
      "https://images.unsplash.com/photo-1563770660941-20978e870e26?auto=format&fit=crop&q=80&w=800",
    titulo: "Optimización de Windows para Gaming",
    descripcion:
      "Desactiva estos 5 servicios innecesarios para ganar hasta un 15% más de FPS.",
    plataforma: "YouTube",
    categoria: "Consejos",
  },
  {
    portada:
      "https://images.unsplash.com/photo-1518770660439-4636190af475?auto=format&fit=crop&q=80&w=800",
    titulo: "Lo último en almacenamiento NVMe",
    descripcion:
      "Probamos las velocidades de lectura de los nuevos discos de estado sólido Gen 6.",
    plataforma: "TikTok",
    categoria: "Tecnología",
  },
  {
    portada:
      "https://images.unsplash.com/photo-1581091226825-a6a2a5aee158?auto=format&fit=crop&q=80&w=800",
    titulo: "Limpieza de periféricos: Mouse y Mousepad",
    descripcion:
      "Mantén tus herramientas de entrada impecables para una precisión de grado competitivo.",
    plataforma: "YouTube",
    categoria: "Mantenimiento",
  },
  {
    portada:
      "https://images.unsplash.com/photo-1485827404703-89b55fcc595e?auto=format&fit=crop&q=80&w=800",
    titulo: "Robótica doméstica: El nuevo estándar",
    descripcion:
      "Drones de seguridad para el hogar que patrullan mientras duermes. ¿Privacidad o seguridad?",
    plataforma: "TikTok",
    categoria: "Novedades",
  },
];
---

<Layout>
  <section class="mt-24">
    <div class="grid grid-cols-2 w-[80%] pt-12 m-auto">
      <div class="flex flex-col gap-2 mx-4">
        <h1 class="text-Blue uppercase font-bold text-3xl">
          Articulos y noticias
        </h1>
        <p class="uppercase text-7xl">Videos</p>
        <p>
          Mira nuestros tutorialeres en video sobre mantenimiento, reparación y
          consejos para tus equipos, en Youtube y Tik Tok.
        </p>
      </div>

      <div class="flex gap-4 items-center ml-auto">
        <a
          href="#"
          class="flex flex-col bg-ContainerBG text-White p-4 rounded-lg hover:bg-Blue hover:duration-200"
        >
          <img src="/IMGS/Icons/YT.webp" alt="Youtube" class="w-48" />
          <div class="flex items-center gap-2">
            <p>Suscribete a nuestro canal de YouTube</p>
            <i class="fa-solid fa-circle-arrow-right"></i>
          </div>
        </a>

        <a
          href="#"
          class="flex flex-col bg-ContainerBG text-White p-4 rounded-lg hover:bg-Blue hover:duration-200"
        >
          <img src="/IMGS/Icons/Tiktok.webp" alt="TikTok" class="w-48" />
          <div class="flex items-center gap-2">
            <p>Siguenos en TikTok</p>
            <i class="fa-solid fa-circle-arrow-right"></i>
          </div>
        </a>
      </div>
    </div>
  </section>

  <section class="my-12 mx-4">
    <div class="w-[80%] m-auto">
      <p class="mb-2 uppercase text-gray-400 tracking-wider">
        Filtrar por categoría
      </p>
      <ul class="flex gap-6">
        <li class="p-4 bg-LightBlue backdrop-blur-lg text-White rounded-lg cursor-pointer hover:bg-White hover:scale-90 hover:text-Blue hover:duration-200">
          Todos
        </li>
        <li class="p-4 bg-LightBlue backdrop-blur-lg text-White rounded-lg cursor-pointer hover:bg-White hover:scale-90 hover:text-Blue hover:duration-200">
          YouTube
        </li>
        <li class="p-4 bg-LightBlue backdrop-blur-lg text-White rounded-lg cursor-pointer hover:bg-White hover:scale-90 hover:text-Blue hover:duration-200">
          Tik Tok
        </li>
      </ul>

      <section class="grid grid-cols-4 gap-6 mt-12">
        {feedVideos.map((video) => (
          <article
            class="bg-ContainerBG text-White p-2 rounded-lg"
            data-aos="fade-right"
          >
            <img src={video.portada} alt={video.titulo} class="" />
            <div class="p-4">
              <h3 class="text-xl font-bold text-Blue">{video.titulo}</h3>
              <p class="text-Green">{video.descripcion}</p>
              <p class="text-LightBlue">{video.plataforma}</p>
            </div>
          </article>
        ))}
      </section>
    </div>
  </section>
</Layout>
