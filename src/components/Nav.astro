---
import Botton from "./Botton.astro"
---
<script>
const Nav = document.getElementById("Nav");


window.addEventListener("scroll", () =>{
    let scroll = window.scrollY; 

    if (scroll > 90){
        Nav?.classList.add("bg-White")
    }
})
</script>


<nav class="grid grid-cols-3 px-4 items-center fixed top-0 w-dvw z-20 left-0" id="Nav">
	<a href="/" class="flex items-center gap-4 ">
        <img src="./IMGS/Logos/Letra.png" alt="Logo AurexLab" class="w-1/6">
        <img src="./IMGS/Logos/Texto.png" alt="Logo AurexLab" class="w-1/4">
    </a>

    <ul class="flex justify-center gap-6">
        <a class="hover:bg-Blue hover:text-White hover:duration-150 hover:scale-90 p-2" href="/">Inicio</a>
        <a class="hover:bg-Blue hover:text-White hover:duration-150 hover:scale-90 p-2" href="#Servicios">Servicios</a>
        <a class="hover:bg-Blue hover:text-White hover:duration-150 hover:scale-90 p-2" href="#Nosotros">Nosotros</a>
        <a class="hover:bg-Blue hover:text-White hover:duration-150 hover:scale-90 p-2" href="/blog">Blog</a>
        <a class="hover:bg-Blue hover:text-White hover:duration-150 hover:scale-90 p-2" href="/videos">Videos</a>
        <a class="hover:bg-Blue hover:text-White hover:duration-150 hover:scale-90 p-2" href="#Contacto">Contacto</a>
    </ul>

    <Botton icon="fa-whatsapp" texto="Whatsapp" tipo="fa-brands" claseExtra="ml-auto"/>
</nav>