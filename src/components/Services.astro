---
interface Props {
  titulo: string;
  precio: string | number;
  destacado?: boolean;
  href?: string;
}

const { titulo, precio, destacado = false, href = "#Contacto" } = Astro.props;

const precioFormateado = Number(precio).toLocaleString("es-CR");
---

<article
  class:list={[
    "relative flex flex-col justify-between rounded-2xl p-6 sm:p-7 transition-all duration-300 border backdrop-blur-md text-Black cursor-pointer",
    destacado
      ? "bg-White border-Blue/70 ring-1 ring-Blue/40 shadow-xl shadow-Blue/10 lg:-translate-y-2"
      : "bg-White/90 border-Blue hover:border-Blue hover:bg-Blue text-White group",
  ]}
>
  {destacado && (
    <span class="self-center -mt-10 mb-4 px-3.5 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-Blue text-white shadow-md">
      Más solicitado
    </span>
  )}

  <div>
    <div class="pb-5 border-b border-slate-800 text-center">
      <h3 class="text-lg font-bold tracking-wide text-Blue group-hover:text-Black">{titulo}</h3>
      <div class="mt-4 flex items-baseline justify-center gap-1">
        <span class="text-3xl sm:text-4xl font-extrabold tracking-tight text-Black group-hover:text-White">
          ₡{precioFormateado}
        </span>
      </div>
    </div>

    <div class="py-6 ">
      <slot />
    </div>
  </div>

  <a
    href={href}
    class:list={[
      "mt-auto w-full py-3 px-4 rounded-xl font-semibold text-sm flex items-center justify-center gap-2 transition-all duration-200 group",
      destacado
        ? "bg-Blue hover:bg-Blue/90 text-white shadow-md shadow-Blue/20"
        : "bg-slate-800/90 hover:bg-White text-slate-100 hover:text-Black border border-slate-700/70 hover:border-Blue",
    ]}
  >
    <span>Ver más detalles</span>
    <i class="fa-solid fa-arrow-right text-xs transition-transform duration-200 group-hover:translate-x-1"></i>
  </a>
</article>
